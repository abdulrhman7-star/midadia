{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, credit balance, and editor preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "description": "User display name (1-80 characters)."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address (owner-only PII)."
        },
        "credits": {
          "type": "integer",
          "description": "Available export credits (0-100000)."
        },
        "maxCredits": {
          "type": "integer",
          "description": "Maximum credit tier cap (1-100000)."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["ar", "en", "fr", "es", "tr", "de", "zh"],
          "description": "UI localization code."
        },
        "darkMode": {
          "type": "boolean",
          "description": "Whether dark theme is active."
        },
        "favoriteTemplateIds": {
          "type": "array",
          "description": "Bounded list of up to 50 starred template IDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp() on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp updated via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "displayName", "credits", "maxCredits", "preferredLanguage", "darkMode", "favoriteTemplateIds", "createdAt", "updatedAt"]
    },
    "SavedDocument": {
      "title": "SavedDocument",
      "description": "A formatted Markdown document with Word page layout settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID matching parent user path."
        },
        "title": {
          "type": "string",
          "description": "Document title (1-200 characters)."
        },
        "markdown": {
          "type": "string",
          "description": "Raw Markdown + LaTeX source (0-150000 characters)."
        },
        "direction": {
          "type": "string",
          "enum": ["rtl", "ltr"],
          "description": "Text direction for Word and preview rendering."
        },
        "orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"],
          "description": "Page orientation."
        },
        "margins": {
          "type": "string",
          "enum": ["normal", "narrow", "wide"],
          "description": "A4 page margin preset."
        },
        "fontFamily": {
          "type": "string",
          "description": "Selected document font family name."
        },
        "fontSizeSp": {
          "type": "integer",
          "description": "Base font size in points/sp (8-32)."
        },
        "watermark": {
          "type": "string",
          "description": "Optional watermark text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "markdown", "direction", "orientation", "margins", "fontFamily", "fontSizeSp", "watermark", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile, export credits, and preferences."
    },
    "/users/{userId}/documents/{docId}": {
      "schema": { "$ref": "#/entities/SavedDocument" },
      "description": "User-owned saved Markdown and Word layout documents."
    }
  }
}
